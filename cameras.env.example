# Camera access codes for go2rtc and bambu-cam. Copy to cameras.env and fill in.
# Only go2rtc and bambu-cam read this file; it holds no other secrets. Never commit cameras.env.

# Bambu X1 (native RTSPS). Code = printer screen > Settings > LAN only mode > Access code.
# Referenced in infra/go2rtc/go2rtc.yaml as ${X1C_02_ACCESS_CODE}
# X1C_02_ACCESS_CODE=

# Bambu P1/A1 (bambu-cam frame-reader; start with: docker compose --profile p1a1 up -d)
# BAMBU_CAMS=p1s-01=192.168.50.23,a1-mini=192.168.50.24
# BAMBU_CODE_P1S_01=
# BAMBU_CODE_A1_MINI=
