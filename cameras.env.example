# Printer LAN access codes. Copy to cameras.env and fill in. Never commit cameras.env.
# Read by: telemetry (MQTT control + FTPS plate uploads, via access_code_env in config/fleet.toml),
#          go2rtc (X1 camera, as ${BAMBU_CODE_<ID>} in infra/go2rtc/go2rtc.yaml) and bambu-cam (P1/A1 cameras).
# One variable per printer: BAMBU_CODE_<printer id, upper case, - replaced by _>.
# Code = printer screen > Settings > LAN only mode > Access code.

# Bambu X1 (camera: native RTSPS)
# BAMBU_CODE_X1C_02=

# Bambu P1/A1 (camera: bambu-cam frame-reader; start with: docker compose --profile p1a1 up -d)
# BAMBU_CAMS=p1s-01=192.168.50.23,a1-mini=192.168.50.24
# BAMBU_CODE_P1S_01=
# BAMBU_CODE_A1_MINI=

# Klipper/Moonraker, only if it requires an API key (api_key_env in config/fleet.toml)
# MOONRAKER_KEY_VORON_01=
