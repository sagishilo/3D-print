# Secrets of the Wave 2 connectors (stores, invoicing, couriers, alert channels).
# Copy to integrations.env (gitignored, never committed), fill in only what you use, then:
#     python scripts/check_integrations_env.py      (prints SET / MISSING, never values)
#     docker compose up -d integrations              (the agent reads the file when it starts)
# The dashboard shows only "set" or "missing" for each key. Every connector starts OFF and in fake mode.

# Demo store (test data; only its live mode would need a token: it has no real service)
DEMO_STORE_TOKEN=

# Shopify (W2-A). Either an app from Shopify's Dev Dashboard installed on your shop (client ID + secret; the
# connector asks Shopify for a short-lived token itself), or the Admin API token of an older custom app.
# Scopes: read_orders, read_customers, read_merchant_managed_fulfillment_orders, write_merchant_managed_fulfillment_orders.
# The shop address (your-shop.myshopify.com) is a setting on the Integrations screen, not a secret.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=

# Morning / Green Invoice (W2-B): Morning > Settings > Developer tools > API keys (an API plan is needed).
# The connector starts in Morning's sandbox (a setting on the Integrations screen); switch to production once a
# sandbox document looks right.
MORNING_API_KEY_ID=
MORNING_API_KEY_SECRET=

# Israel Post (W2-B) needs no secret: Israel Post has no public label API. Live, you make the label at Israel Post
# and type its tracking number when you ship; the sender's details for printed labels are settings.
