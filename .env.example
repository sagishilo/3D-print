# PrintFarm Ops environment. Do NOT edit secrets by hand: run scripts/init_env.py (README step 3),
# which copies this file to .env and fills every CHANGE_ME value. Never commit .env.

# --- generated secrets ---
POSTGRES_PASSWORD=CHANGE_ME
NATS_SERVICES_PASSWORD=CHANGE_ME
NATS_AGENTS_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME

# --- admin login ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=CHANGE_ME

# --- HTTPS: addresses the dashboard answers on (comma separated) ---
# localhost + this PC's fixed LAN IP, e.g. "localhost, 192.168.50.10"
SITE_HOSTS=localhost

# Printer camera access codes live in cameras.env (see cameras.env.example), not here.
