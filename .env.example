# PrintFarm Ops environment. Do NOT edit secrets by hand: run scripts/init_env.py (README step 3),
# which copies this file to .env and fills every CHANGE_ME value. Never commit .env.

# --- generated secrets ---
POSTGRES_PASSWORD=CHANGE_ME
NATS_SERVICES_PASSWORD=CHANGE_ME
NATS_AGENTS_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME

# --- admin login ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=CHANGE_ME

# --- HTTPS: addresses the dashboard answers on (comma separated) ---
# localhost + this PC's fixed LAN IP, e.g. "localhost, 192.168.50.10"
SITE_HOSTS=localhost

# --- Social Listening (optional) ---
# Claude API key for the social agent (console.anthropic.com > API keys). Empty: captured posts are kept and
# wait; set it, then "docker compose up -d social" and Rescore them on the Social screen.
ANTHROPIC_API_KEY=

# --- Backups (optional; defaults: every 24 h, keep 14) ---
# BACKUP_INTERVAL_S=86400
# BACKUP_KEEP=14
# Encrypted off-site backups (README "Off-site backups"). Leave both empty for local backups only.
# BACKUP_REMOTE=gdrive:printfarm-backups
# BACKUP_AGE_RECIPIENT=age1...            (the PUBLIC key; keep the private key off this PC)
# BACKUP_OFFSITE_KEEP_DAYS=90

# Printer camera access codes live in cameras.env (see cameras.env.example), not here.
